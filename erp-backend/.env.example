DATABASE_URL="postgresql://erp_user:erp_pass@localhost:5433/erp_db"
APP_PORT=3000
JWT_SECRET="cambia_esto_en_produccion"
JWT_EXPIRES_IN="8h"
# Lista separada por comas; en producción es obligatoria y no admite *
CORS_ORIGIN="http://localhost:8001"
SII_P12_PASSWORD="clave_del_certificado_p12"
NODE_ENV="development"
SWAGGER="false"
LOGIN_MAX_INTENTOS=5
# Rutas del CAF y del certificado (por defecto sii-certs/CAF_Prueba.xml y sii-certs/mi_certificado.p12)
SII_CAF_PATH=""
SII_P12_PATH=""

# ── Sincronización local → nube (ADR-02) ──
# local: todo en una base (desarrollo) · edge: el local de la PYME · cloud: la nube
MODO="local"
# En la nube y en cada local: secreto compartido para firmar la licencia (Lease Token)
LEASE_SECRET=""
# Margen de tolerancia, en minutos, después de las 24 h de licencia
LEASE_GRACIA_MIN=60
# Solo en el local (MODO=edge): dirección de la nube y credenciales de esta instalación
CLOUD_URL=""
INSTALACION_ID=""
INSTALACION_SECRETO=""
# Cada cuánto intenta enviar la cola a la nube (0 = solo a pedido)
SYNC_INTERVALO_MS=30000
